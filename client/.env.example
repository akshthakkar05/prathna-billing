# Client Environment Configuration (Vercel / Local)

# In Local Development: leave blank to use the local Vite proxy (/auth, /products, etc.)
# VITE_API_URL=

# On Vercel: Set to your deployed Render Backend Web Service URL (without trailing slash)
# Example: https://prathna-billing-backend.onrender.com
VITE_API_URL=https://your-render-backend-name.onrender.com
