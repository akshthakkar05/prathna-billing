# Server Environment Configuration (Render / Production / Local)

PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Database URLs
# 1. DATABASE_URL: Transaction Pooler URL (Port 6543) with ?pgbouncer=true
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. DIRECT_URL: Direct Connection URL (Port 5432) for migrations & db push
# Example: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Secret key used for signing JWT tokens (generate a long random 64-char string)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# CORS Allowed Origin (set to your Vercel URL or * for wildcard)
# Example: https://prathna-billing.vercel.app
CORS_ORIGIN=*
