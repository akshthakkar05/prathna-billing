generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String?  @unique
  hsnCode       String
  gstRate       Decimal  @db.Decimal(5, 2) // e.g. 18.00
  purchasePrice Decimal  @db.Decimal(10, 2)
  sellingPrice  Decimal  @db.Decimal(10, 2)
  currentStock  Decimal  @default(0) @db.Decimal(10, 2)
  minStockLevel Decimal  @default(0) @db.Decimal(10, 2)
  unit          String   @default("PCS")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseItem[]
  stockTransactions StockTransaction[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  mobile    String?
  address   String?
  gstin     String?
  state     String?  // 2-digit GST state code (e.g. "24")
  createdAt DateTime @default(now())

  invoices Invoice[]
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique // e.g. INV-1001
  invoiceDate   DateTime @default(now())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  taxType      String  @default("INTRASTATE") // INTRASTATE | INTERSTATE
  taxableTotal Decimal @db.Decimal(10, 2)
  cgstTotal    Decimal @db.Decimal(10, 2)
  sgstTotal    Decimal @db.Decimal(10, 2)
  igstTotal    Decimal @default(0) @db.Decimal(10, 2)
  roundOff     Decimal @default(0) @db.Decimal(10, 2)
  billAmount   Decimal @db.Decimal(10, 2)

  paymentStatus String  @default("UNPAID") // UNPAID | PARTIAL | PAID
  paymentMethod String? // CASH | UPI | CARD | CREDIT

  createdAt DateTime @default(now())

  items   InvoiceItem[]
  returns SalesReturn[]
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Snapshot fields — never re-derive from live Product later
  descriptionSnapshot String
  hsnSnapshot         String
  gstRateSnapshot     Decimal @db.Decimal(5, 2)

  qty          Decimal @db.Decimal(10, 2)
  rate         Decimal @db.Decimal(10, 2) // rate excl. GST
  taxableValue Decimal @db.Decimal(10, 2)
  cgstAmount   Decimal @db.Decimal(10, 2)
  sgstAmount   Decimal @db.Decimal(10, 2)
  igstAmount   Decimal @default(0) @db.Decimal(10, 2)
  amount       Decimal @db.Decimal(10, 2) // final line total

  returnItems SalesReturnItem[]
}

model StockTransaction {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  type      String   // PURCHASE | SALE | SALES_RETURN | PURCHASE_RETURN | ADJUSTMENT
  quantity  Decimal  @db.Decimal(10, 2) // positive = stock in, negative = stock out
  reference String?  // e.g. invoice id or purchase id
  createdAt DateTime @default(now())
}

// --- Slice 2 Models ---

model Supplier {
  id        String   @id @default(uuid())
  name      String
  mobile    String?
  address   String?
  gstin     String?
  pan       String?
  notes     String?
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Purchase {
  id              String   @id @default(uuid())
  supplierId      String
  supplier        Supplier @relation(fields: [supplierId], references: [id])
  referenceNumber String   // invoice/reference number
  purchaseDate    DateTime @default(now())
  totalAmount     Decimal  @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  qty     Decimal @db.Decimal(10, 2)
  rate    Decimal @db.Decimal(10, 2)
  gstRate Decimal @db.Decimal(5, 2)
  amount  Decimal @db.Decimal(10, 2)
}

model InvoiceCounter {
  id      Int    @id @default(autoincrement())
  name    String @unique
  current Int    @default(1000)
}

model CompanySettings {
  id            String   @id @default(uuid())
  name          String   @default("Your Company Name")
  address       String?  @default("")
  phone         String?  @default("")
  gstin         String?  @default("")
  pan           String?  @default("")
  logoUrl       String?
  terms         String?  @default("1. Goods once sold will not be taken back.\n2. Subject to local jurisdiction.")
  termsGujarati String?  @default("શરતો અને નિયમો:\n\n૧. એકવાર વેચેલો માલ પાછો લેવામાં આવશે નહીં.\n૨. વોરંટી કંપનીના નિયમો મુજબ રહેશે.\n૩. ન્યાય ક્ષેત્ર સ્થાનિક રહેશે.")
  updatedAt     DateTime @updatedAt
}

// --- Slice 3 Models: Sales Returns ---

model SalesReturn {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  returnDate  DateTime @default(now())
  reason      String?
  totalAmount Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  items SalesReturnItem[]
}

model SalesReturnItem {
  id            String      @id @default(uuid())
  salesReturnId String
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  invoiceItemId String
  invoiceItem   InvoiceItem @relation(fields: [invoiceItemId], references: [id])

  qty    Decimal @db.Decimal(10, 2)
  amount Decimal @db.Decimal(10, 2)
}
